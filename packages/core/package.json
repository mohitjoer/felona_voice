{
  "name": "felona-voice",
  "version": "3.0.0",
  "description": "Voice agent framework powered by JEV (Joint Embedding Vectors) for dynamic conversation flow",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "voice",
    "voice-agent",
    "ai",
    "jev",
    "state-machine",
    "conversation-graph",
    "workflow",
    "embedding",
    "deepgram",
    "elevenlabs",
    "stt",
    "tts",
    "vad",
    "conversational-ai",
    "realtime"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felona-voice/felona-voice.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/felona-voice/felona-voice#readme",
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "werift": "^0.24.4"
  },
  "peerDependenciesMeta": {
    "werift": {
      "optional": true,
      "description": "Only required for WebRTCTransport. Loaded lazily, so the rest of the framework works without it."
    }
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "werift": "^0.24.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
